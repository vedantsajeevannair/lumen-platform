generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./lumen.db"
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  /// bcrypt hash — never the password itself. The column is named for what it
  /// holds so nobody is tempted to compare it directly.
  ///
  /// Null for an account created by signing in with Google, which has no
  /// password to hash. Storing a random hash instead would be dishonest: the
  /// column would claim a credential exists that nobody can ever present, and
  /// the password login has to reject these accounts either way.
  passwordHash String?
  /// Set when the account was created through an identity provider. Google's
  /// stable subject id rather than the email, because an email can be
  /// reassigned within a workspace and the subject cannot.
  googleId     String?     @unique
  name         String
  /// Optional: an account can exist with an email alone. Stored so an OTP can
  /// reach a phone when one is given, never required to sign in.
  phone        String?
  /// Set the first time the address or number is proven with a one-time code.
  /// Null means unproven, which is not the same as untrusted — a seeded staff
  /// account has never been through the flow and must still be able to work.
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  // ADMINISTRATOR | SUPERVISOR | ENGINEER are staff, created by seeding.
  // CITIZEN accounts are self-registered from the public sign-up form and can
  // only report issues and follow their own reports.
  role         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  reported      Complaint[]    @relation("ReportedBy")
  notifications Notification[]
  pushTokens    PushToken[]
  otpCodes      OtpCode[]
  biometrics    BiometricCredential[]
}

/// A one-time code, for proving an address or authorising a password reset.
///
/// The code itself is never stored — only a bcrypt hash of it, for the same
/// reason a password is not stored: a leaked database must not hand anyone a
/// working credential. A row is consumed on first successful use and counts
/// its own failed attempts, so guessing six digits is bounded rather than
/// unlimited.
model OtpCode {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// VERIFY_EMAIL | VERIFY_PHONE | RESET_PASSWORD
  purpose     String
  /// EMAIL | SMS — which way it was sent, for the audit trail.
  channel     String
  /// The address or number it was sent to, lowercased. Kept even when userId
  /// is null so a request for an unknown address is still rate limited.
  destination String
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([destination, purpose])
  @@index([expiresAt])
}

/// A device allowed to sign in behind the phone's own biometric check.
///
/// The phone holds a random token in its secure enclave, released only after
/// Face ID or a fingerprint; the server holds a hash of it. The biometric is
/// therefore never sent anywhere and never leaves the device — the server only
/// learns that the device released its token, which is the strongest claim it
/// can honestly make about a fingerprint it cannot see.
model BiometricCredential {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Stable per install. Unique so re-enrolling a device replaces its row
  /// rather than leaving a second credential that nobody can revoke.
  deviceId   String    @unique
  tokenHash  String
  /// "iPhone 15" or similar, shown in the account screen so a user can tell
  /// which device they are revoking.
  label      String?
  platform   String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

model Department {
  id            String      @id @default(cuid())
  code          String      @unique
  name          String
  civicCategory String      @default("ROADS") // the taxonomy category this department owns
  slaTarget     Int // target resolution hours
  users         User[]
  engineers     Engineer[]
  complaints    Complaint[]
}

model Engineer {
  id           String      @id @default(cuid())
  code         String      @unique
  name         String
  phone        String
  zone         String
  skills       String // comma-separated damage classes this engineer handles
  status       String // AVAILABLE | ON_TASK | OFF_DUTY
  lat          Float // current field position, used by the assignment optimiser
  lng          Float
  resolvedJobs Int
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id])
  complaints   Complaint[]
}

model Complaint {
  id          String @id @default(cuid())
  ref         String @unique // CMP-10245
  title       String
  description String
  zone        String
  address     String
  lat         Float
  lng         Float

  // --- Feature 1: CV detection result
  category     String // damage class predicted by the detector (e.g. "Pothole")
  civicCategory String? // civic category the class belongs to (ROADS/ELECTRICAL/WASTE/WATER/PUBLIC)
  autoRouted   Boolean @default(false) // was the department chosen by the model?
  aiPredicted  Boolean @default(false) // was the category set by the model?
  aiConfidence Float? // top detection confidence
  aiModelMode  String? // TRAINED | FALLBACK — provenance of the prediction
  detections   String? // JSON array of {label, confidence, box, area_ratio}

  // --- Feature 2: severity scoring
  severityScore Float? // 0-100 computed from detection geometry
  severityBand  String? // MINOR | MODERATE | SIGNIFICANT | SEVERE
  priority      String // LOW | MEDIUM | HIGH | CRITICAL (derived from severity)
  priorityScore Float? // explainable rule score: severity, safety, location and report pressure
  priorityFactors String? // JSON audit trail for the priority score
  slaHours      Int

  // --- Feature 3: duplicate detection
  embedding     String? // JSON array — 512-D CNN feature vector
  duplicateOfId String?
  duplicateOf   Complaint?  @relation("Duplicates", fields: [duplicateOfId], references: [id])
  duplicates    Complaint[] @relation("Duplicates")
  dupSimilarity Float? // cosine similarity to the primary complaint
  dupDistanceM  Float? // metres between the two reports
  dupScore      Float? // composite image, distance, category and description score
  dupCategoryMatch Boolean?
  dupDescriptionSimilarity Float?


  // --- Feature 5: assignment optimisation provenance
  assignMethod   String? // OPTIMISED | MANUAL
  assignDistance Float? // km from engineer position at time of assignment

  status    String // SUBMITTED | ASSIGNED | IN_PROGRESS | PENDING_REVIEW | CLOSED | REJECTED
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  departmentId String
  department   Department       @relation(fields: [departmentId], references: [id])
  engineerId   String?
  engineer     Engineer?        @relation(fields: [engineerId], references: [id])
  images       ComplaintImage[]
  events       TimelineEvent[]

  // The citizen who reported it, when one did. Nullable because seeded and
  // staff-entered complaints have no reporter, and because a complaint must
  // outlive the account that raised it — a deleted user should not take a
  // municipal work item with them.
  reporterId String?
  reporter   User?   @relation("ReportedBy", fields: [reporterId], references: [id])

  notifications Notification[]

  // Set when a resident says the work was not actually done. Kept as its own
  // field rather than inferred from the timeline so the queue can surface
  // reopened complaints without replaying every event.
  reopenedAt DateTime?

  // --- Feature 6: repair material estimation
  // Set by the engineer on site; decides which mix the estimator uses.
  roadType     String? // BITUMINOUS | CONCRETE
  potholes     PotholeMeasurement[]

  @@index([status])
  @@index([createdAt])
}

model ComplaintImage {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  kind        String // CITIZEN | ENGINEER_BEFORE | ENGINEER_AFTER
  path        String // /uploads/<file> served from public/
  /// SHA-256 of the original file's bytes.
  ///
  /// Lets the system recognise the *same photograph* being submitted twice —
  /// a different thing from the duplicate-complaint check, which asks whether
  /// two reports describe the same defect. Someone re-sending the identical
  /// image is almost always a repeat submission, and saying so before they
  /// file spares them the wait and the department the duplicate.
  sha256      String?
  annotated   String? // /uploads/<file> with detection boxes drawn
  detections  String? // JSON detections for this specific image
  severity    Float?
  createdAt   DateTime  @default(now())

  @@index([sha256])
}

model TimelineEvent {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  type        String // CREATED | AI_DETECTION | AI_DUPLICATE | ASSIGNMENT | STATUS_CHANGE | AI_VERIFICATION
  message     String
  actor       String
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  actorRole String
  action    String
  module    String
  target    String
  details   String
  createdAt DateTime @default(now())
}

/**
 * A single pothole measured on site by the engineer's team.
 *
 * Volume and perimeter are computed on write and stored rather than derived on
 * read: they are what the material estimate and any submitted BOQ are based
 * on, so the figure that was signed off must not silently change if the
 * formula is ever adjusted.
 */
model PotholeMeasurement {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  label       String // P1, P2 ... within the complaint
  lengthM     Float
  widthM      Float
  depthM      Float
  volumeM3    Float // lengthM x widthM x depthM
  perimeterM  Float // 2 x (lengthM + widthM)
  recordedBy  String
  recordedAt  DateTime  @default(now())
  /// ESTIMATED (from the photograph) | MEASURED (on site). Everything
  /// downstream shows which, so a planning figure is never read as a survey.
  source      String    @default("MEASURED")

  @@index([complaintId])
}

/// A message to one person about one complaint.
///
/// Written when something happens that the recipient would otherwise have to
/// poll for — an engineer assigned, work started, a closure approved. Without
/// this a resident has no way to learn anything except by logging in and
/// looking, which is the difference between a dashboard and a service.
model Notification {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaintId String?
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  type    String // ASSIGNED | STARTED | COMPLETED | CLOSED | REJECTED | REOPENED | VERIFY_FAILED
  message String
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

/// A device that has agreed to receive push notifications.
///
/// A row per device, not per user: someone signing in on a phone and a tablet
/// should be told on both. The token is the unique key because the same device
/// reinstalling gets the same one back, and a user switching accounts on a
/// shared phone must move that device rather than leave it pointed at the
/// previous account's complaints.
model PushToken {
  id        String   @id @default(cuid())
  /// Expo push token, of the form ExponentPushToken[...]. Not a secret in the
  /// credential sense, but it addresses someone's device, so it is never
  /// returned by any read endpoint.
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "ios" | "android" — only for working out which platform a failure came
  /// from when Expo rejects a token.
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
